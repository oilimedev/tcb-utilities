---
import type { HubItem } from '../data/content';
interface Props { item: HubItem; }
const { item } = Astro.props;
---
<a href={item.category === 'Guide' ? '/guides' : item.category === 'Tracker' ? '/trackers' : item.category === 'Community' ? '/community' : '/tools'} class="surface card-lift focus-ring group flex min-h-52 flex-col rounded-2xl p-5">
  <div class="flex items-start justify-between">
    <span class="grid h-11 w-11 place-items-center rounded-xl text-lg font-semibold" style={`background:${item.accent}18;color:${item.accent}`}>{item.icon}</span>
    {item.status && <span class="rounded-full border border-line px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest subtle">{item.status}</span>}
  </div>
  <div class="mt-auto pt-8"><p class="mb-2 text-[11px] font-semibold uppercase tracking-[.16em]" style={`color:${item.accent}`}>{item.category}</p><h3 class="text-lg font-bold tracking-tight">{item.title}</h3><p class="subtle mt-2 text-sm leading-6">{item.description}</p></div>
  <span class="mt-5 text-sm font-semibold opacity-0 transition group-hover:opacity-100" style={`color:${item.accent}`}>Open utility →</span>
</a>
