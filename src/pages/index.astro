---
import Layout from "../layouts/Layout.astro";
import UtilityCard from "../components/UtilityCard.astro";
import { games, hubItems } from "../data/content";
---

<Layout>
  <section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <div class="grid items-end gap-10 lg:grid-cols-[1fr_420px]">
      <div><h1
          class="max-w-4xl text-5xl font-black leading-[.98] tracking-[-.05em] sm:text-6xl lg:text-7xl"
        >
          Less menu time.<br /><span class="text-blue">More game time.</span>
        </h1><p class="subtle mt-6 max-w-2xl text-lg leading-8">
          Fast, focused utilities for the games that I play.
        </p><div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#utilities"
            class="focus-ring rounded-xl bg-blue px-5 py-3 text-sm font-bold text-[#07111e] transition hover:brightness-110"
            >Explore utilities</a
          ><a
            href="/games"
            class="surface focus-ring rounded-xl px-5 py-3 text-sm font-semibold"
            >Browse games</a
          >
        </div>
      </div>
      <aside class="surface rounded-2xl p-3" aria-label="Quick status">
        <div class="flex items-center justify-between px-3 py-3">
          <div>
            <p class="text-sm font-bold">Available Games</p>
          </div><span
            class="rounded-full bg-blue/10 px-2.5 py-1 text-[10px] font-bold text-blue"
            >1 ACTIVE</span
          >
        </div><div class="space-y-1">
          {
            games.map((game) => (
              <a
                href={`/games/${game.link}`}
                class="flex items-center gap-3 rounded-xl p-3 transition hover:bg-white/5"
              >
                <>
                  <span
                    class="grid h-10 w-10 place-items-center rounded-lg text-xs font-black text-white"
                    style={`background:${game.color}22;color:${game.color}`}
                  >
                    {game.code}
                  </span>
                  <span>
                    <>
                      <b class="block text-sm">{game.name}</b>
                      <span class="subtle text-xs">{game.detail}</span>
                    </>
                  </span>
                  <span class="subtle ml-auto">›</span>
                </>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
    <div
      class="mt-16 grid grid-cols-2 gap-2 border-y border-line py-5 sm:grid-cols-2"
    >
      <div>
        <b class="text-xl">2</b><span class="subtle ml-2 text-xs"
          >utilities</span
        >
      </div><div>
        <b class="text-xl text-blue">Free</b><span class="subtle ml-2 text-xs"
          >for players</span
        >
      </div>
    </div>
  </section>
  <section id="utilities" class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
    <div
      class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end"
    >
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[.2em] text-violet">
          Featured utilities
        </p><h2 class="text-3xl font-bold tracking-tight">
          Everything useful, nothing noisy.
        </h2>
      </div><a href="/tools" class="subtle text-sm hover:text-ink"
        >View all utilities →</a
      >
    </div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {hubItems.map((item) => <UtilityCard item={item} />)}
    </div>
  </section>
</Layout>
