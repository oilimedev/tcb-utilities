---
import Layout from "../layouts/Layout.astro";
import { games } from "../data/content";
---

<Layout title="Settings — TCB Utilities"
  ><section class="mx-auto max-w-3xl px-5 py-16 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-violet">
      Settings
    </p><h1 class="mt-3 text-4xl font-black tracking-tight">
      Make it yours.
    </h1><p class="subtle mt-4 leading-7">
      These starter preferences are saved locally in your browser.
    </p><form class="surface mt-10 divide-y divide-line rounded-2xl px-6">
      <label class="flex items-center gap-5 py-6"
        ><span class="flex-1"
          ><b class="block">Compact utility cards</b><span
            class="subtle mt-1 block text-sm"
            >Fit more tools into each view.</span
          ></span
        ><input class="h-5 w-5 accent-blue" type="checkbox" /></label
      ><label class="flex items-center gap-5 py-6"
        ><span class="flex-1"
          ><b class="block">Default game</b><span
            class="subtle mt-1 block text-sm"
            >Open your favorite game first.</span
          ></span
        ><select class="input-shell rounded-lg border px-3 py-2 text-sm"
          >{games.map((game) => <option>{game.name}</option>)}</select
        ></label>
    </form>
  </section></Layout
>
