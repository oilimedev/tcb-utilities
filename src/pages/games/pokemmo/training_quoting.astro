---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Training Quoting — PokeMMO — TCB Utilities"
  description="Plan and share clear PokeMMO level and EV training quotes."
>
  <section class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-12">
    <a
      class="focus-ring subtle inline-flex items-center gap-2 rounded-lg text-sm transition hover:text-ink"
      href="/games/pokemmo"
    >
      <span>←</span> PokeMMO game hub
    </a>
    <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[.2em] text-violet">
        Training Quoting
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">
        Quickly plan and get your training quotes.
      </h2>
      <p class="subtle mt-4 max-w-2xl leading-7">
        Easier to get a clear overview of your required training plan and get an
        estimated cost.
      </p>
      <button
        id="training-guide-help"
        class="surface focus-ring mt-6 rounded-xl px-4 py-2 text-sm font-semibold"
        type="button"
        aria-controls="training-guide"
        hidden
      >
        Help: show quick guide
      </button>

      <section
        id="training-guide"
        class="relative mt-10 rounded-2xl bg-blue-900 p-4"
        aria-labelledby="training-guide-title"
      >
        <div class="mb-4 flex items-center justify-between px-2">
          <p id="training-guide-title" class="text-sm font-bold">Quick guide</p>
          <button
            id="training-guide-dismiss"
            class="focus-ring grid h-8 w-8 place-items-center rounded-lg text-xl leading-none subtle transition hover:bg-white/10 hover:text-ink"
            type="button"
            aria-label="Dismiss training quote guide"
          >
            ×
          </button>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <article class="surface rounded-2xl p-6">
            <span class="text-sm font-bold text-blue">01</span>
            <h3 class="mt-6 text-lg font-bold">Select your Pokemon</h3>
            <p class="subtle mt-2 text-sm leading-6">
              Capture the level and EV outcome the player is aiming for. It's
              optional to specify the desired moveset and current experience.
            </p>
          </article>
          <article class="surface rounded-2xl p-6">
            <span class="text-sm font-bold text-blue">02</span>
            <h3 class="mt-6 text-lg font-bold">Review the plan</h3>
            <p class="subtle mt-2 text-sm leading-6">
              Check the training details together before finalizing the quote.
            </p>
          </article>
          <article class="surface rounded-2xl p-6">
            <span class="text-sm font-bold text-blue">03</span>
            <h3 class="mt-6 text-lg font-bold">Copy and share</h3>
            <p class="subtle mt-2 text-sm leading-6">
              Send a clear, compact overview instead of rebuilding the details
              everytime.
            </p>
          </article>
        </div>
      </section>

      <section
        class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]"
        aria-labelledby="training-list-title"
      >
        <div class="surface rounded-2xl p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-[.2em] text-blue">
            Training list
          </p>
          <h3
            id="training-list-title"
            class="mt-3 text-2xl font-bold tracking-tight"
          >
            Add a Pokémon to quote.
          </h3>
          <p class="subtle mt-3 max-w-xl text-sm leading-6">
            Start with the level change.
            <br />
            You can add another Pokémon whenever you need to expand the quote.
          </p>
          <form id="training-list-form" class="mt-8 grid gap-5" novalidate>
            <label
              class="grid gap-2 text-sm font-semibold"
              for="pokemon-search"
            >
              Pokémon
              <span class="relative">
                <input
                  id="pokemon-search"
                  class="input-shell focus-ring w-full rounded-xl border px-4 py-3 font-normal"
                  type="search"
                  autocomplete="off"
                  placeholder="Search Pokémon"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-controls="pokemon-results"
                  aria-expanded="false"
                  required
                />
                <ul
                  id="pokemon-results"
                  class="surface absolute z-10 mt-2 max-h-64 w-full overflow-y-auto rounded-xl p-1"
                  role="listbox"
                  aria-label="Pokémon results"
                  hidden
                >
                </ul>
              </span>
            </label>
            <input id="pokemon-select" name="pokemonId" type="hidden" />
            <p
              id="pokemon-growth-type"
              class="subtle -mt-2 text-sm"
              aria-live="polite"
              hidden
            >
            </p>
            <label class="flex items-center gap-3 text-sm font-semibold">
              <input
                id="leveling-toggle"
                class="h-5 w-5 accent-blue"
                type="checkbox"
              />
              Leveling
            </label>
            <div id="current-experience-field" hidden>
              <label
                class="grid gap-2 text-sm font-semibold"
                for="current-experience"
              >
                Current experience <span class="subtle font-normal"
                  >(optional)</span
                >
                <input
                  id="current-experience"
                  name="currentExperience"
                  class="input-shell focus-ring rounded-xl border px-4 py-3 font-normal"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  step="1"
                  placeholder="Defaults to 0"
                  aria-describedby="experience-help"
                  disabled
                />
              </label>
            </div>
            <p class="subtle text-sm" id="experience-help">
              Training goal: Level 100.
            </p>
            <label class="flex items-center gap-3 text-sm font-semibold">
              <input
                id="ev-training-toggle"
                class="h-5 w-5 accent-blue"
                type="checkbox"
              />
              EV Training
            </label>
            <div
              id="ev-training-fields"
              class="grid gap-4 sm:grid-cols-2"
              hidden
            >
              {
                [
                  ["hp", "HP"],
                  ["attack", "Attack"],
                  ["defense", "Defense"],
                  ["special-attack", "Special Attack"],
                  ["special-defense", "Special Defense"],
                  ["speed", "Speed"],
                ].map(([key, label]) => (
                  <label
                    class="grid gap-2 text-sm font-semibold"
                    for={`ev-${key}`}
                  >
                    {label}
                    <input
                      id={`ev-${key}`}
                      class="input-shell focus-ring rounded-xl border px-4 py-3 font-normal"
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max="255"
                      step="1"
                      value="0"
                      disabled
                    />
                  </label>
                ))
              }
            </div>
            <p class="subtle text-sm" id="ev-help">
              Training goal: 510 EV points.
            </p>
            <label id="validations"></label>
            <button
              class="focus-ring w-fit rounded-xl bg-blue px-5 py-3 text-sm font-bold text-[#07111e] transition hover:brightness-110"
              type="submit">Add to list</button
            >
            <p id="training-list-status" class="sr-only" aria-live="polite"></p>
          </form>
        </div>

        <aside
          class="surface rounded-2xl p-6"
          aria-labelledby="training-list-summary-title"
        >
          <div class="flex items-center justify-between gap-3">
            <h3 id="training-list-summary-title" class="text-lg font-bold">
              Your training list
            </h3>
            <span
              id="training-list-count"
              class="rounded-full bg-blue/10 px-2.5 py-1 text-[10px] font-bold text-blue"
              >0 POKÉMON</span
            >
          </div>
          <label
            class="grid gap-2 text-sm font-semibold py-2"
            for="pokeygen-per-exp"
          >
            $ per EXP point:
            <span class="relative">
              <input
                id="pokeygen-rate"
                class="input-shell focus-ring w-full rounded-xl border px-4 py-3 font-normal"
                placeholder="0.25$ per EXP"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                min="0.01"
                value="0.25"
              /></span
            ></label
          >
          <label class="grid gap-2 text-sm font-semibold py-2" for="ev-rate">
            $ per EV training:
            <span class="relative">
              <input
                id="ev-rate"
                class="input-shell focus-ring w-full rounded-xl border px-4 py-3 font-normal"
                placeholder="25,000$ per EV train"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                min="1"
                value="25000"
              /></span
            ></label
          >
          <p id="training-list-empty" class="subtle mt-6 text-sm leading-6">
            No Pokémon added yet. Add your first training target to begin the
            quote.
          </p>
          <ol
            id="training-list-entries"
            class="mt-5 space-y-3"
            aria-live="polite"
          >
          </ol>
        </aside>
      </section>
    </div>
  </section>
  <script>
    import pokemon from "../../../data/pokemmo/pokemon.json";
    import experienceTypes from "../../../data/pokemmo/exp_types.json";

    const guide = document.querySelector<HTMLElement>("#training-guide");
    const dismissButton = document.querySelector<HTMLButtonElement>(
      "#training-guide-dismiss",
    );
    const helpButton = document.querySelector<HTMLButtonElement>(
      "#training-guide-help",
    );
    const guidePreferenceKey = "tcb-pokemmo-training-quote-guide-dismissed";

    const setGuideVisibility = (visible: boolean, focusGuide = false) => {
      if (guide) guide.hidden = !visible;
      if (helpButton) helpButton.hidden = visible;
      if (visible && focusGuide) dismissButton?.focus();
    };

    try {
      if (localStorage.getItem(guidePreferenceKey) === "true") {
        setGuideVisibility(false);
      }
    } catch {
      // Keep the guide available when local storage is unavailable.
    }

    dismissButton?.addEventListener("click", () => {
      try {
        localStorage.setItem(guidePreferenceKey, "true");
      } catch {
        // Dismissing still works for this visit when local storage is unavailable.
      }
      setGuideVisibility(false);
      helpButton?.focus();
    });

    helpButton?.addEventListener("click", () => setGuideVisibility(true, true));

    type TrainingEntry = {
      pokemonId: number;
      name: string;
      growthType?: string;
      currentExperience?: number;
      level100Experience?: number;
      evs?: Record<string, number>;
    };

    const trainingListForm = document.querySelector<HTMLFormElement>(
      "#training-list-form",
    );
    const pokemonSearchInput =
      document.querySelector<HTMLInputElement>("#pokemon-search");
    const pokemonSelect =
      document.querySelector<HTMLInputElement>("#pokemon-select");
    const pokemonResults =
      document.querySelector<HTMLUListElement>("#pokemon-results");
    const pokemonGrowthType = document.querySelector<HTMLElement>(
      "#pokemon-growth-type",
    );
    const currentExperienceInput = document.querySelector<HTMLInputElement>(
      "#current-experience",
    );
    const validationsLabel =
      document.querySelector<HTMLLabelElement>("#validations");
    const levelingToggle =
      document.querySelector<HTMLInputElement>("#leveling-toggle");
    const currentExperienceField = document.querySelector<HTMLElement>(
      "#current-experience-field",
    );
    const evTrainingToggle = document.querySelector<HTMLInputElement>(
      "#ev-training-toggle",
    );
    const evTrainingFields = document.querySelector<HTMLElement>(
      "#ev-training-fields",
    );
    const evInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        "[id^=ev-]:not(#ev-training-toggle)",
      ),
    );
    const trainingListEntries = document.querySelector<HTMLOListElement>(
      "#training-list-entries",
    );
    const trainingListEmpty = document.querySelector<HTMLElement>(
      "#training-list-empty",
    );
    const trainingListCount = document.querySelector<HTMLElement>(
      "#training-list-count",
    );
    const trainingListStatus = document.querySelector<HTMLElement>(
      "#training-list-status",
    );
    const pokeygenRateInput =
      document.querySelector<HTMLInputElement>("#pokeygen-rate");
    const evRateInput = document.querySelector<HTMLInputElement>("#ev-rate");
    const trainingListStorageKey = "tcb-pokemmo-training-list";
    const pokemonById = new Map(pokemon.map((entry) => [entry.id, entry]));
    const experienceTypeById = new Map(
      experienceTypes.map((entry) => [entry.id, entry]),
    );
    let filteredPokemon = pokemon.slice(0, 12);
    let activePokemonIndex = -1;
    let trainingEntries: TrainingEntry[] = [];
    const expectedEvs = [
      "hp",
      "attack",
      "defense",
      "special-attack",
      "special-defense",
      "speed",
    ];

    try {
      const storedEntries = JSON.parse(
        sessionStorage.getItem(trainingListStorageKey) ?? "[]",
      );
      if (Array.isArray(storedEntries)) {
        trainingEntries = storedEntries.filter(
          (entry): entry is TrainingEntry =>
            Number.isInteger(entry?.pokemonId) &&
            typeof entry.name === "string" &&
            typeof entry.growthType === "string" &&
            Number.isInteger(entry.currentExperience) &&
            Number.isInteger(entry.level100Experience) &&
            entry.currentExperience >= 0 &&
            entry.level100Experience > 0,
        );
      }
    } catch {
      // Start with an empty list when session storage is unavailable or invalid.
    }

    const removeFromList = (index: number) => {
      trainingEntries.splice(index, 1);
      renderTrainingList();
    }

    const renderTrainingList = () => {
      if (trainingListEntries) {
        let totalCost = 0;
        trainingListEntries.replaceChildren(
          ...trainingEntries.map((entry, index) => {
            const item = document.createElement("li");
            item.className =
              "rounded-xl border border-line bg-white/[.03] px-4 py-3";
            const name = document.createElement("strong");
            name.className = "block text-sm";
            name.textContent = entry.name;
            item.append(name);
            const levels = document.createElement("span");
            levels.className = "subtle mt-1 block text-xs";
            if (entry.level100Experience && entry.currentExperience) {
              console.dir('goes in');
              const remainingExp =
                entry.level100Experience - entry.currentExperience;
              const currentRate = Number(
                pokeygenRateInput ? pokeygenRateInput.value : 0.25,
              );
              const levelingCost = Math.ceil(currentRate * remainingExp);
              totalCost += levelingCost;
              levels.textContent = `${entry.currentExperience.toLocaleString()} EXP → Level 100: ${remainingExp.toLocaleString()} EXP = ${levelingCost.toLocaleString()}$`;
              item.append(levels);
            }
            if (entry.evs) {
              const evRate = Number(evRateInput ? evRateInput.value : 25000);
              totalCost += evRate;
              const evs = document.createElement("span");
              evs.className = "subtle mt-1 block text-xs";
              evs.textContent = `EVs: ${Object.entries(entry.evs)
                .map(([stat, value]) => {
                  if (expectedEvs.includes(stat) && value > 0) {
                    return `${stat.toUpperCase()}: ${value} `;
                  }
                })
                .join("")}: $${evRate.toLocaleString()}`;
              item.append(evs);
            }
            return item;
          }),
        );
        const item = document.createElement("li");
        item.className =
          "rounded-xl border border-line bg-white/[.03] px-4 py-3";
        item.textContent = `Total Cost: $${totalCost.toLocaleString()}`;
        trainingListEntries.append(item);
      }
      if (trainingListEmpty)
        trainingListEmpty.hidden = trainingEntries.length > 0;
      if (trainingListCount) {
        trainingListCount.textContent = `${trainingEntries.length} ${trainingEntries.length === 1 ? "POKÉMON" : "POKÉMON"}`;
      }
    };

    const saveTrainingList = () => {
      try {
        sessionStorage.setItem(
          trainingListStorageKey,
          JSON.stringify(trainingEntries),
        );
      } catch {
        // The in-memory list remains available for this page view.
      }
    };

    currentExperienceInput?.addEventListener("input", () =>
      currentExperienceInput.setCustomValidity(""),
    );
    levelingToggle?.addEventListener("change", () => {
      if (currentExperienceField)
        currentExperienceField.hidden = !levelingToggle.checked;
      if (currentExperienceInput)
        currentExperienceInput.disabled = !levelingToggle.checked;
      if (!levelingToggle.checked && currentExperienceInput) {
        currentExperienceInput.value = "";
        currentExperienceInput.setCustomValidity("");
      }
      if (validationsLabel) validationsLabel.innerHTML = "";
    });
    evTrainingToggle?.addEventListener("change", () => {
      if (evTrainingFields) evTrainingFields.hidden = !evTrainingToggle.checked;
      evInputs.forEach((input) => (input.disabled = !evTrainingToggle.checked));
      if (!evTrainingToggle.checked)
        evInputs.forEach((input) => {
          input.value = "0";
          input.setCustomValidity("");
        });
      if (validationsLabel) validationsLabel.innerHTML = "";
    });
    pokeygenRateInput?.addEventListener("input", () => {
      pokeygenRateInput.setCustomValidity("");
      renderTrainingList();
    });
    evRateInput?.addEventListener("input", () => {
      evRateInput.setCustomValidity("");
      renderTrainingList();
    });

    const showGrowthType = () => {
      const selectedPokemon = pokemonById.get(Number(pokemonSelect?.value));
      const experienceType = selectedPokemon
        ? experienceTypeById.get(selectedPokemon.exp_type_id)
        : undefined;
      if (pokemonGrowthType) {
        pokemonGrowthType.hidden = !experienceType;
        pokemonGrowthType.textContent = experienceType
          ? `Growth type: ${experienceType.name} · Level 100: ${experienceType.ammount.toLocaleString()} EXP`
          : "";
      }
    };

    const closePokemonResults = () => {
      if (pokemonResults) pokemonResults.hidden = true;
      pokemonSearchInput?.setAttribute("aria-expanded", "false");
      pokemonSearchInput?.removeAttribute("aria-activedescendant");
      activePokemonIndex = -1;
    };

    const selectPokemon = (entry: (typeof pokemon)[number]) => {
      if (pokemonSelect) pokemonSelect.value = String(entry.id);
      if (pokemonSearchInput) {
        pokemonSearchInput.value = entry.name;
        pokemonSearchInput.setCustomValidity("");
      }
      showGrowthType();
      closePokemonResults();
    };

    const renderPokemonResults = () => {
      const query = pokemonSearchInput?.value.trim().toLowerCase() ?? "";
      filteredPokemon = pokemon
        .filter((entry) => entry.name.toLowerCase().includes(query))
        .slice(0, 12);
      activePokemonIndex = -1;
      if (!pokemonResults) return;
      pokemonResults.replaceChildren(
        ...filteredPokemon.map((entry, index) => {
          const option = document.createElement("li");
          option.id = `pokemon-result-${index}`;
          option.className =
            "cursor-pointer rounded-lg px-3 py-2 text-sm transition hover:bg-white/5";
          option.setAttribute("role", "option");
          option.dataset.pokemonId = String(entry.id);
          option.textContent = entry.name;
          return option;
        }),
      );
      if (!filteredPokemon.length) {
        const emptyOption = document.createElement("li");
        emptyOption.className = "subtle px-3 py-2 text-sm";
        emptyOption.setAttribute("role", "option");
        emptyOption.setAttribute("aria-disabled", "true");
        emptyOption.textContent = "No Pokémon found.";
        pokemonResults.append(emptyOption);
      }
      pokemonResults.hidden = false;
      pokemonSearchInput?.setAttribute("aria-expanded", "true");
    };

    const setActivePokemon = (index: number) => {
      if (!filteredPokemon.length) return;
      activePokemonIndex =
        (index + filteredPokemon.length) % filteredPokemon.length;
      pokemonSearchInput?.setAttribute(
        "aria-activedescendant",
        `pokemon-result-${activePokemonIndex}`,
      );
      pokemonResults
        ?.querySelectorAll<HTMLElement>("[role=option]")
        .forEach((option, optionIndex) => {
          option.classList.toggle(
            "bg-white/10",
            optionIndex === activePokemonIndex,
          );
        });
    };

    pokemonSearchInput?.addEventListener("input", () => {
      if (pokemonSelect) pokemonSelect.value = "";
      pokemonSearchInput.setCustomValidity(
        "Choose a Pokémon from the results.",
      );
      showGrowthType();
      renderPokemonResults();
    });

    pokemonSearchInput?.addEventListener("focus", renderPokemonResults);
    pokemonSearchInput?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        if (pokemonResults?.hidden) renderPokemonResults();
        setActivePokemon(activePokemonIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        if (pokemonResults?.hidden) renderPokemonResults();
        setActivePokemon(activePokemonIndex - 1);
      } else if (event.key === "Enter" && activePokemonIndex >= 0) {
        event.preventDefault();
        selectPokemon(filteredPokemon[activePokemonIndex]);
      } else if (event.key === "Escape") {
        closePokemonResults();
      }
    });

    pokemonSearchInput?.addEventListener("blur", () => {
      window.setTimeout(closePokemonResults, 120);
    });

    pokemonResults?.addEventListener("click", (event) => {
      const option = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-pokemon-id]",
      );
      const selectedPokemon = pokemonById.get(
        Number(option?.dataset.pokemonId),
      );
      if (selectedPokemon) selectPokemon(selectedPokemon);
    });

    trainingListForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const experienceValue = levelingToggle?.checked
        ? (currentExperienceInput?.value.trim() ?? "")
        : "";
      const currentExperience =
        experienceValue === "" ? 0 : Number(experienceValue);
      const evs = evTrainingToggle?.checked
        ? Object.fromEntries(
            evInputs.map((input) => [
              input.id.replace("ev-", ""),
              Number(input.value),
            ]),
          )
        : undefined;
      const selectedPokemon = pokemonById.get(Number(pokemonSelect?.value));
      const experienceType = selectedPokemon
        ? experienceTypeById.get(selectedPokemon.exp_type_id)
        : undefined;

      if (!selectedPokemon || !experienceType) {
        pokemonSelect?.setCustomValidity(
          "Choose a Pokémon to add to the list.",
        );
      }
      if (!Number.isInteger(currentExperience) || currentExperience < 0) {
        currentExperienceInput?.setCustomValidity(
          "Enter a whole number of 0 or more for current experience.",
        );
      }
      if (
        evs &&
        Object.values(evs).some(
          (value) => !Number.isInteger(value) || value < 0 || value > 255,
        )
      ) {
        evInputs.find(
          (input) =>
            !Number.isInteger(Number(input.value)) ||
            Number(input.value) < 0 ||
            Number(input.value) > 255,
        );
      }
      if (
        !trainingListForm.reportValidity() ||
        !selectedPokemon ||
        !experienceType
      )
        return;

      if (
        !levelingToggle?.checked &&
        !evTrainingToggle?.checked
      ) {
        if(validationsLabel) validationsLabel.innerText = "Select a type of training.";
        return;
      }

      let newTraining = {
        pokemonId: selectedPokemon.id,
        name: selectedPokemon.name,
        ...(levelingToggle?.checked ? { growType: experienceType.name } : {}),
        ...(levelingToggle?.checked
          ? { currentExperience: currentExperience }
          : {}),
        ...(levelingToggle?.checked
          ? { level100Experience: experienceType.ammount }
          : {}),
        ...(evs && evTrainingToggle?.checked ? { evs } : {}),
      };
      trainingEntries.push(newTraining);
      saveTrainingList();
      renderTrainingList();
      trainingListForm.reset();
      if (trainingListStatus) {
        trainingListStatus.textContent = `${selectedPokemon.name} added to the training list.`;
      }
      showGrowthType();
      pokemonSelect?.focus();
    });

    renderTrainingList();
  </script>
</Layout>
