---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Training Quoting — PokeMMO — TCB Utilities"
  description="Plan and share clear PokeMMO level and EV training quotes."
>
  <section class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-12">
    <a
      class="focus-ring subtle inline-flex items-center gap-2 rounded-lg text-sm transition hover:text-ink"
      href="/games/pokemmo"
    >
      <span>←</span> PokeMMO game hub
    </a>
    <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[.2em] text-violet">Training Quoting</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">Quickly plan and get your training quotes.</h2>
      <p class="subtle mt-4 max-w-2xl leading-7">
        Easier to get a clear overview of your required training plan and get an estimated cost.
      </p>

      <!-- Make the div afterwards dismissable on first visit, and don't show again if user clicks on a cross. -->
      <div class="mt-10 grid gap-4 md:grid-cols-3 bg-blue-900 p-4 rounded-2xl">
        <article class="surface rounded-2xl p-6">
          <span class="text-sm font-bold text-blue">01</span>
          <h3 class="mt-6 text-lg font-bold">Select your Pokemon</h3>
          <p class="subtle mt-2 text-sm leading-6">Capture the level and EV outcome the player is aiming for. It's optional to specify the desired moveset and current experience.</p>
        </article>
        <article class="surface rounded-2xl p-6">
          <span class="text-sm font-bold text-blue">02</span>
          <h3 class="mt-6 text-lg font-bold">Review the plan</h3>
          <p class="subtle mt-2 text-sm leading-6">Check the training details together before finalizing the quote.</p>
        </article>
        <article class="surface rounded-2xl p-6">
          <span class="text-sm font-bold text-blue">03</span>
          <h3 class="mt-6 text-lg font-bold">Copy and share</h3>
          <p class="subtle mt-2 text-sm leading-6">Send a clear, compact overview instead of rebuilding the details everytime.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>
