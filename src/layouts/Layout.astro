---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "TCB Utilities — Play smarter",
  description = "A focused home for gaming tools.",
} = Astro.props;
const nav = [
  ["Home", "/"],
  ["Games", "/games"],
  ["Tools", "/tools"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090c12" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("tcb-theme");
      if (savedTheme === "light")
        document.documentElement.classList.add("prefers-light");
    </script>
  </head>
  <body class="antialiased">
    <div class="grid-fade pointer-events-none fixed inset-0 -z-10"></div>
    <header class="nav-shell sticky top-0 z-40 border-b">
      <div class="mx-auto flex h-17 max-w-7xl items-center gap-5 px-5 lg:px-8">
        <a
          href="/"
          class="focus-ring flex shrink-0 items-center gap-2.5 rounded-lg"
          aria-label="TCB Utilities home"
        >
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-blue text-sm font-black text-[#07111e]"
            >T</span
          >
          <span class="font-bold tracking-tight"
            >TCB <span class="subtle font-medium">Utilities</span></span
          >
        </a>
        <nav
          class="ml-5 hidden items-center gap-1 lg:flex"
          aria-label="Primary navigation"
        >
          {
            nav.map(([label, href]) => (
              <a
                class:list={[
                  "focus-ring rounded-lg px-3 py-2 text-sm transition hover:bg-white/5",
                  Astro.url.pathname === href ? "text-blue" : "subtle",
                ]}
                href={href}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <button
            id="search-trigger"
            class="input-shell focus-ring hidden min-w-56 items-center gap-3 rounded-xl border px-3.5 py-2 text-left text-sm md:flex"
            aria-label="Open search"
          >
            <span class="subtle">⌕</span><span class="subtle flex-1"
              >Search utilities</span
            ><span class="kbd subtle rounded px-1.5 py-0.5 text-[10px]"
              >⌘ K</span
            >
          </button>
          <button
            id="theme-toggle"
            class="surface focus-ring grid h-10 w-10 place-items-center rounded-xl"
            aria-label="Toggle color theme">◐</button
          >
          <a
            href="/settings"
            class="surface focus-ring grid h-10 w-10 place-items-center rounded-xl text-sm"
            aria-label="Settings">⚙</a
          >
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer
      class="mx-auto mt-18 flex max-w-7xl flex-col gap-4 border-t border-line px-5 py-8 text-sm subtle md:flex-row md:items-center lg:px-8"
    >
      <p>Built by TCB.</p>
      <div class="md:ml-auto flex gap-5">
        <a class="hover:text-ink" href="/tools">Tools</a><a
          class="hover:text-ink"
          href="/settings">Settings</a
        >
      </div>
    </footer>
    <dialog
      id="search-dialog"
      class="m-auto w-[min(92vw,600px)] rounded-2xl border border-line bg-[#111620] p-0 text-ink shadow-2xl backdrop:bg-black/70"
    >
      <form method="dialog" class="border-b border-line p-4">
        <label
          class="input-shell flex items-center gap-3 rounded-xl border px-4"
          ><span class="subtle">⌕</span><input
            id="site-search"
            class="w-full bg-transparent py-3.5 outline-none"
            placeholder="Search tools, trackers, and guides…"
            autocomplete="off"
          /><button class="subtle text-xs">ESC</button></label
        >
      </form>
      <div id="search-results" class="max-h-80 p-3">
        <p class="subtle px-3 py-8 text-center text-sm">
          Start typing to explore TCB Utilities.
        </p>
      </div>
    </dialog>
    <script>
      import { hubItems } from "../data/content";
      const body = document.body;
      if (localStorage.getItem("tcb-theme") === "light")
        body.classList.add("light");
      document.querySelector("#theme-toggle")?.addEventListener("click", () => {
        body.classList.toggle("light");
        localStorage.setItem(
          "tcb-theme",
          body.classList.contains("light") ? "light" : "dark",
        );
      });
      const dialog =
        document.querySelector<HTMLDialogElement>("#search-dialog");
      const input = document.querySelector<HTMLInputElement>("#site-search");
      const results = document.querySelector<HTMLDivElement>("#search-results");
      const openSearch = () => {
        dialog?.showModal();
        setTimeout(() => input?.focus(), 0);
      };
      document
        .querySelector("#search-trigger")
        ?.addEventListener("click", openSearch);
      window.addEventListener("keydown", (event) => {
        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k"
        ) {
          event.preventDefault();
          openSearch();
        }
      });
      input?.addEventListener("input", () => {
        const term = input.value.toLowerCase().trim();
        const matches = hubItems.filter((item) =>
          `${item.title} ${item.description} ${item.category}`
            .toLowerCase()
            .includes(term),
        );
        if (results)
          results.innerHTML = term
            ? matches.length
              ? matches
                  .map(
                    (item) =>
                      `<a href="/tools" class="block rounded-xl px-3 py-3 hover:bg-white/5"><span class="mr-3">${item.icon}</span><b>${item.title}</b><span class="subtle ml-2 text-xs">${item.category}</span></a>`,
                  )
                  .join("")
              : '<p class="subtle px-3 py-8 text-center text-sm">No utilities found.</p>'
            : '<p class="subtle px-3 py-8 text-center text-sm">Start typing to explore TCB Utilities.</p>';
      });
    </script>
  </body>
</html>
